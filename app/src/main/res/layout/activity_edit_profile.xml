<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- TextView for Name (read-only) -->
    <TextView
        android:id="@+id/nameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#000"
        android:text="Name"
        android:textSize="16sp"
        android:layout_marginBottom="30dp"
        android:hint="Name" />

    <!-- TextView for Student ID (read-only) -->
    <TextView
        android:id="@+id/studentIdTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/nameTextView"
        android:layout_marginBottom="30dp"
        android:textColor="#000"
        android:text="Student ID"
        android:textSize="16sp" />

    <!-- TextView for Email (read-only) -->
    <TextView
        android:id="@+id/emailTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/studentIdTextView"
        android:layout_marginBottom="40dp"
        android:textColor="#000"
        android:text="Email"
        android:textSize="16sp" />

    <!-- EditText for Phone Number -->
    <TextView
        android:id="@+id/phoneTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/emailTextView"
        android:layout_marginBottom="10dp"
        android:textColor="#000"
        android:text="Phone Number"
        android:textSize="16sp" />

    <!-- EditText for Phone Number input -->
    <EditText
        android:id="@+id/phoneNoEditText"
        android:layout_width="381dp"
        android:layout_height="56dp"
        android:layout_below="@id/phoneTextView"
        android:layout_marginBottom="30dp"
        android:hint="Enter New Phone Number"
        android:inputType="phone"
        android:textColor="#000" />

    <!-- TextView for Campus Selection -->
    <TextView
        android:id="@+id/campusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/phoneNoEditText"
        android:layout_marginBottom="5dp"
        android:textColor="#000"
        android:text="Campus"
        android:textSize="16sp" />

    <!-- Spinner for Campus Selection -->
    <Spinner
        android:id="@+id/campusSpinner"
        android:layout_width="388dp"
        android:layout_height="51dp"
        android:layout_below="@id/campusTextView"
        android:layout_marginBottom="20dp" />

    <!-- TextView for Campus Selection -->
    <TextView
        android:id="@+id/roleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/campusSpinner"
        android:layout_marginBottom="5dp"
        android:textColor="#000"
        android:text="Role"
        android:textSize="16sp" />

    <!-- Spinner for Campus Selection -->
    <Spinner
        android:id="@+id/roleSpinner"
        android:layout_width="388dp"
        android:layout_height="51dp"
        android:layout_below="@id/roleTextView"
        android:layout_marginBottom="20dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_below="@id/roleSpinner"
        android:layout_marginTop="20dp" />

</RelativeLayout>


