<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EventHive" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <!-- ActionBar style -->
        <item name="actionBarStyle">@style/Widget.EventHive.ActionBar</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Custom ActionBar style -->
    <style name="Widget.EventHive.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@drawable/gradient_background</item>
        <item name="titleTextStyle">@style/TextAppearance.EventHive.ActionBar.Title</item>
    </style>

    <!-- ActionBar title text style -->
    <style name="TextAppearance.EventHive.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Login Activity theme -->
    <style name="Theme.EventHive.Login" parent="Theme.EventHive">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- Splash Screen theme without ActionBar -->
    <style name="Theme.EventHive.NoActionBar" parent="Theme.EventHive">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--  App Compat  -->
    <style name="Theme.EventHive.AppCompat.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>
</resources>